{
  "name": "lineage-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "pnpm install && pnpm --filter example exec playwright install chromium",
    "build": "pnpm --filter \"./packages/**\" build",
    "dev": "pnpm build && pnpm --parallel --filter \"./packages/**\" --filter example dev",
    "dev:payload": "pnpm build && pnpm --parallel --filter \"./packages/**\" --filter example-payload dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && node --test 'scripts/*.test.mjs'",
    "check": "pnpm format:check && pnpm build && pnpm lint --max-warnings 0 && pnpm typecheck && pnpm test && pnpm --filter example build-storybook --quiet",
    "release": "node scripts/release.mjs",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "lefthook": "^2.2.2",
    "prettier": "3.9.10",
    "semver": "7.8.5",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.2"
  }
}
