{
  "name": "@rock-solid/storybook-addon-lineage",
  "version": "0.1.1",
  "description": "A dbt-style lineage graph of your components in Storybook: what each file is built with, where it is used, and what a change affects.",
  "keywords": [
    "storybook-addon",
    "lineage",
    "dependency-graph",
    "dbt"
  ],
  "license": "MIT",
  "homepage": "https://github.com/rock-solid/lineage-kit/tree/main/packages/storybook-addon-lineage#readme",
  "bugs": "https://github.com/rock-solid/lineage-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rock-solid/lineage-kit.git",
    "directory": "packages/storybook-addon-lineage"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": "./dist/preset.js",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/manager.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "dependency-cruiser": "17.4.3",
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@storybook/react": "10.6.1",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "storybook": "10.6.1",
    "tsup": "8.5.1",
    "typescript": "5.7.3",
    "vite": "7.3.6"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "storybook": "^10.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "storybook": {
    "displayName": "Lineage",
    "supportedFrameworks": [
      "react-vite",
      "nextjs-vite"
    ]
  }
}
